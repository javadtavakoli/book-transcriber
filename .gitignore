# Large, machine-local artifacts — never commit these (multi-GB)
venv/
models/

# Runtime progress/diagnostics
.transcribe_progress.txt
.transcribe_fault.txt

# Transcripts / audio (personal session data)
*.txt
*.wav
*.m4a
# ...but keep project text files that belong in the repo
!README*.txt
!requirements.txt
!tests/fixtures/*.txt
!requirements-*.txt

# Python
__pycache__/
*.pyc
!prompts/*.txt

# Local run logs
*.log
.run_out.txt

# Brainstorming mockups
.superpowers/

# Local PyInstaller builds
build/
dist/

# Files the CI and release workflows generate (installer output goes to dist/)
requirements-ci.txt
requirements-gui-ci.txt
/release-notes.md
